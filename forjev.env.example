# Qwen stays on port 8000. Only this HTTP adapter runs on port 8001.
OPENJEV_BACKEND=forjev
OPENJEV_UPSTREAM=http://127.0.0.1:8000
OPENJEV_UPSTREAM_MODEL=qwen3.8-flash-next-a5b
OPENJEV_HOST=0.0.0.0
OPENJEV_PORT=8001
OPENJEV_MAX_INFLIGHT=2
FORJEV_MAX_CHOICES=20
# chat_logprobs: existing API; no serving restart if already compatible.
# engine_scores: register /v1/decision_scores inside vLLM's API process.
# Checked B12X V2: deploy/B12X-bridge.Dockerfile also preserves candidate IDs
# in speculative batches. Build from the original serving image and reload it.
# prefill_scores: experimental, requires the checked B12X V2 runtime patch
# and a vLLM restart/model reload. Run live acceptance before selecting it.
# See docs/decision-scores.md; installing the adapter alone is insufficient.
FORJEV_SCORING=chat_logprobs
# Optional: independent authentication for the upstream and this frontend.
FORJEV_UPSTREAM_API_KEY=
OPENJEV_API_KEY=
OPENJEV_ORIGIN_SECRET=
FORJEV_READY_TIMEOUT=120
